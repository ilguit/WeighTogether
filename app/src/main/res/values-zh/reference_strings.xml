    <string name="reference_secondary_chumlea">其他非交互式参考资料：Chumlea — 总体水分模型。</string>
    <string name="reference_secondary_janssen">其他非交互式参考资料：Janssen 等，2000 — 骨骼肌量方程。</string>
    <string name="reference_secondary_niams">其他非交互式参考资料：NIAMS — 估算骨量与骨密度及 T 值的区别。</string>
    <string name="reference_secondary_espen">其他非交互式参考资料：ESPEN/GLIM — 临床 FFMI 背景，不作为 ScaleSync 的评级标准。</string>

    <string name="reference_help_weight_meaning">体重秤直接测得的身体质量。</string>
    <string name="reference_help_weight_calculation">根据已保存的身高和 Xiaomi Legacy 的 BMI 阈值计算体重范围。因此，体重类别始终与 BMI 类别一致。</string>
    <string name="reference_help_weight_dependencies">已保存的身高和体重。不使用阻抗。</string>
    <string name="reference_help_weight_limitations">仅凭体重无法判断健康状况。未满 20 岁或超出体重秤适用范围时不显示类别。</string>
    <string name="reference_help_impedance_meaning">体重秤电极之间的电阻，用作计算身体成分的输入值。</string>
    <string name="reference_help_impedance_calculation">该数值以欧姆为单位从体重秤的 BLE 数据包中读取，不会单独重新计算。</string>
    <string name="reference_help_impedance_dependencies">足部接触情况、电极排列、频率、身体形态、水合状态、皮肤温度和测量条件。</string>
    <string name="reference_help_impedance_limitations">该数值本身不是健康指标。不同 BIA 设备的量表不能互换，也没有通用参考范围。</string>
    <string name="reference_help_bmi_meaning">反映体重与身高关系的指标。BMI 不反映身体成分，也不构成诊断。</string>
    <string name="reference_help_bmi_calculation">体重（千克）除以已保存身高（米）的平方。类别采用 Xiaomi Legacy 的 18.5、25、28 和 32 阈值。</string>
    <string name="reference_help_bmi_dependencies">体重和已保存的身高。</string>
    <string name="reference_help_bmi_limitations">这些类别并非世界卫生组织当前采用的临床分类。未满 20 岁时不显示类别。</string>
    <string name="reference_help_body_fat_meaning">脂肪组织占总体重的估算比例。</string>
    <string name="reference_help_body_fat_calculation">与 Xiaomi 兼容的 BIA 公式使用体重、阻抗、身高、年龄和性别。类别采用 Xiaomi Legacy 按年龄和性别划分的评级表。</string>
    <string name="reference_help_body_fat_dependencies">个人资料中的当前性别、测量当日年龄、已保存的身高和 BIA 测量条件。</string>
    <string name="reference_help_body_fat_limitations">这是算法估算值，并非对脂肪组织的直接测量。在相似条件下持续观察变化趋势更有意义。</string>
    <string name="reference_help_body_fat_mass_meaning">脂肪组织的估算质量，单位为千克。</string>
    <string name="reference_help_body_fat_mass_calculation">脂肪量 = 体重 × 体脂率。参考类别采用 FMI（脂肪量 ÷ 身高²），并与 Schutz 的第 5/第 95 百分位数比较。</string>
    <string name="reference_help_body_fat_mass_dependencies">估算体脂率、体重、已保存的身高、当前性别和年龄。</string>
    <string name="reference_help_body_fat_mass_limitations">第 5 至第 95 百分位数基于日内瓦成人群体，而“正常”是 ScaleSync 的产品解读。未满 18 岁或超过 98 岁时无法使用该评级标准。</string>
    <string name="reference_help_water_meaning">总体水分占体重的估算比例，并非饮水量。</string>
    <string name="reference_help_water_calculation">与 Xiaomi 兼容的公式根据估算身体成分得出该指标；类别采用 Xiaomi Legacy 按性别划分的评级标准。</string>
    <string name="reference_help_water_dependencies">当前性别、身体成分、水合状态和测量条件。</string>
    <string name="reference_help_water_limitations">不能替代对脱水或水肿的评估。</string>
    <string name="reference_help_water_mass_meaning">总体水分的估算质量，单位为千克。</string>
    <string name="reference_help_water_mass_calculation">体重 × 体水分率。</string>
    <string name="reference_help_water_mass_dependencies">体型和估算体水分率。</string>
    <string name="reference_help_water_mass_limitations">体型越大，绝对量通常越高，因此该数值本身不能反映水合状态。没有可兼容的通用千克参考标准。</string>
    <string name="reference_help_muscle_mass_meaning">肌肉组织的估算质量。</string>
    <string name="reference_help_muscle_mass_calculation">ScaleSync 从体重中减去估算脂肪量和骨量。类别采用 Xiaomi Legacy 按性别和身高划分的阈值。</string>
    <string name="reference_help_muscle_mass_dependencies">当前性别、已保存的身高、体重和所有 BIA 输入值。</string>
    <string name="reference_help_muscle_mass_limitations">该数值取决于算法，不能测量肌肉力量或功能。</string>
    <string name="reference_help_skeletal_muscle_meaning">带动身体活动的肌肉的估算质量。</string>
    <string name="reference_help_skeletal_muscle_calculation">Janssen 方程使用身高、阻抗、性别和年龄。评级时，将骨骼肌量除以体重并转换为百分比，四舍五入至 0.1%%，再与 OMRON 评级表比较。</string>
    <string name="reference_help_skeletal_muscle_dependencies">当前性别和年龄、已保存的身高、体重及阻抗。</string>
    <string name="reference_help_skeletal_muscle_limitations">Janssen 使用全身 BIA，而 Xiaomi 使用足对足 BIA。采用 OMRON 类别属于面向消费者的解读，不能评估肌力或诊断肌少症。未满 18 岁或超过 80 岁时无参考范围。</string>
    <string name="reference_help_bone_mass_meaning">骨骼矿物质成分的估算质量。</string>
    <string name="reference_help_bone_mass_calculation">与 Xiaomi 兼容的公式使用性别和 BIA 估算的瘦体成分。类别取决于性别和体重。</string>
    <string name="reference_help_bone_mass_dependencies">当前性别、体重和 BIA 计算结果。</string>
    <string name="reference_help_bone_mass_limitations">这不是骨密度、BMD/T 值或骨质疏松症筛查。</string>
    <string name="reference_help_protein_meaning">体内蛋白质成分的估算比例。</string>
    <string name="reference_help_protein_calculation" formatted="false">与 Xiaomi 兼容的内部公式使用肌肉量、体重和体水分。Xiaomi Legacy 的阈值为 16% 和 20%。</string>
    <string name="reference_help_protein_dependencies">计算肌肉量和体水分所用的全部输入值。</string>
    <string name="reference_help_protein_limitations">不能反映蛋白质摄入量、血液蛋白质水平或膳食质量。</string>
    <string name="reference_help_protein_mass_meaning">由 ScaleSync 内部公式估算的蛋白质成分质量。</string>
    <string name="reference_help_protein_mass_calculation">体重 × 蛋白质率。</string>
    <string name="reference_help_protein_mass_dependencies">估算肌肉量、体水分、蛋白质率和体重。</string>
    <string name="reference_help_protein_mass_limitations">这不是经过验证的全身蛋白质量、血液蛋白质检测结果或膳食目标。没有可兼容的通用千克参考标准。</string>
    <string name="reference_help_visceral_fat_meaning">内脏周围脂肪的估算指数。</string>
    <string name="reference_help_visceral_fat_calculation">与 Xiaomi 兼容的回归公式使用性别、年龄、身高和体重。Xiaomi Legacy 的阈值为 10 和 15。</string>
    <string name="reference_help_visceral_fat_dependencies">当前性别和年龄、已保存的身高及体重。</string>
    <string name="reference_help_visceral_fat_limitations">这是无量纲的算法评级，并非质量、百分比、腰围或 CT/MRI 面积。</string>
    <string name="reference_help_bmr_meaning">身体在静息状态下一天消耗的估算能量。</string>
    <string name="reference_help_bmr_calculation">ScaleSync 采用基于性别、年龄、身高和体重的公式。Xiaomi Legacy 的参考阈值等于体重乘以按年龄和性别划分的系数。</string>
    <string name="reference_help_bmr_dependencies">当前性别和年龄、已保存的身高及体重。</string>
    <string name="reference_help_bmr_limitations">这不是每日热量目标、膳食建议或直接测热法的测量结果。</string>
    <string name="reference_help_metabolic_age_meaning">基于身体成分、由特定算法得出的指标。</string>
    <string name="reference_help_metabolic_age_calculation">与 Xiaomi 兼容的回归公式使用身高、体重、年龄、阻抗和性别。参照 TANITA 的方式，将结果与测量当日个人资料中的实际年龄比较后划分类别。</string>
    <string name="reference_help_metabolic_age_dependencies">当前性别和出生日期、已保存的身高、体重及阻抗。</string>
    <string name="reference_help_metabolic_age_limitations">不能据此确定生物年龄，也不用于诊断。参考范围仅适用于 18 至 99 岁。</string>
    <string name="reference_help_lean_body_mass_meaning">身体成分公式所使用的 Xiaomi Legacy 内部估算值。</string>
    <string name="reference_help_lean_body_mass_calculation">回归公式使用身高、体重、阻抗和年龄，然后将结果限制在算法的技术上限内。</string>
    <string name="reference_help_lean_body_mass_dependencies">当前年龄、已保存的身高、体重及阻抗。</string>
    <string name="reference_help_lean_body_mass_limitations">此字段并不严格等同于临床上的去脂体重。外部 FFMI 阈值不适用于此字段；技术上限也不是参考范围。</string>
</resources>
